# Public site URL (canonical URLs, sitemap, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.org

# Contact form (Resend) — https://resend.com
# Without RESEND_API_KEY, submissions are only logged to the server console in development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@example.org
CONTACT_FROM_EMAIL="LUMEN <site@example.org>"
